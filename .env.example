# Brevo (https://app.brevo.com/settings/keys/api) — required for the contact form to deliver email.
BREVO_API_KEY=

# Optional overrides — sensible defaults are set in src/lib/config.ts.
# The sender must be verified in Brevo. A sender on your own authenticated domain is the most reliable.
BREVO_SENDER_EMAIL=no-reply@ifnotgod.com
BREVO_SENDER_NAME="IFNOTGOD TECH LTD Website"
CONTACT_RECIPIENT_EMAIL=ifnotgodtech@gmail.com

# Accounts. Built into the site, so changing it needs a new build. Keep it off in production until
# subscriptions use the real backend too: they still use a stand-in that refuses to run there.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false
# Encrypts the login cookie, which holds the backend's token. Required wherever accounts are on,
# except local development. Generate with: openssl rand -base64 32
ACCOUNTS_SESSION_SECRET=
# Google sign-in: the OAuth client id from Google Cloud (the backend holds its secret). Its authorised
# redirect URI is this site's /login/google/callback. Without it, "Continue with Google" explains
# that it didn't work.
GOOGLE_CLIENT_ID=

# The backend API's address, used only on the server, and WEB's own key for it, which must match
# the backend's WEB_APP_KEY. Locally, the backend runs on http://localhost:8000 with local-web-app-key.
BACKEND_API_URL=https://api.ifnotgod.com
BACKEND_APP_KEY=

# The site's main address, used for the canonical URL, sitemap, sharing image and structured data.
NEXT_PUBLIC_SITE_URL=https://www.ifnotgod.com
